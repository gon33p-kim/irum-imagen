{
  "name": "irum-imagen",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "GPT Image 2.5 generation and editing from Codex ChatGPT authentication",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "bin": {
    "irum-imagen": "./src/cli/generate.js",
    "iim": "./src/cli/generate.js"
  },
  "files": [
    "src/",
    "types/",
    "skills/irum-imagen/",
    "NOTICE.md",
    "VERSION"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "build": "npm run check && npm run build:types",
    "build:types": "tsc --project tsconfig.types.json",
    "generate": "node src/cli/generate.js",
    "smoke:live": "bash scripts/smoke-live.sh",
    "sync-version": "node scripts/sync-version.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "image-generation",
    "gpt-image-2.5",
    "agent-skill",
    "chatgpt",
    "openai",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IrumHahn/irum-imagen.git"
  },
  "homepage": "https://github.com/IrumHahn/irum-imagen#readme",
  "bugs": {
    "url": "https://github.com/IrumHahn/irum-imagen/issues"
  },
  "author": "IrumHahn",
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
